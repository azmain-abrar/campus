rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staffEmails/$(request.auth.token.email)); }
    function canManage() { return isAdmin() || isStaff(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validGrade(grade) { return grade == null || (grade is number && grade >= 0 && grade <= 4); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'user' && request.resource.data.email == request.auth.token.email;
      allow update: if (isAdmin() && request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email) || (isOwner(uid) && request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
      match /courses/{courseId} {
        allow read: if isOwner(uid) || canManage();
        allow create: if isOwner(uid) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.courseCode is string && request.resource.data.courseName is string && request.resource.data.semester is string && request.resource.data.credit is number && request.resource.data.credit > 0 && request.resource.data.credit <= 10 && request.resource.data.gradePoint == null;
        allow update: if request.resource.data.ownerUid == resource.data.ownerUid && ((canManage() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gradePoint', 'updatedAt']) && validGrade(request.resource.data.gradePoint)) || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseCode', 'courseName', 'credit', 'semester', 'instructor', 'updatedAt']) && request.resource.data.gradePoint == resource.data.gradePoint && (!('gradePoint' in resource.data) || resource.data.gradePoint == null) && request.resource.data.courseCode is string && request.resource.data.courseName is string && request.resource.data.semester is string && request.resource.data.credit is number && request.resource.data.credit > 0 && request.resource.data.credit <= 10));
        allow delete: if canManage() || (isOwner(uid) && (!('gradePoint' in resource.data) || resource.data.gradePoint == null));
      }
    }
    match /{path=**}/courses/{courseId} { allow read: if canManage() || (signedIn() && resource.data.ownerUid == request.auth.uid); }
    match /allowedEmails/{email} { allow read: if isAdmin() || (signedIn() && request.auth.token.email == email); allow create, update, delete: if canManage(); }
    match /staffEmails/{email} { allow read: if isAdmin() || (signedIn() && request.auth.token.email == email); allow create, update, delete: if isAdmin(); }
    match /students/{studentId} { allow read: if signedIn() && (canManage() || resource.data.email == request.auth.token.email); allow create, update, delete: if canManage(); }
    match /notices/{noticeId} { allow read: if signedIn(); allow create, update, delete: if canManage(); }
    match /events/{eventId} { allow read: if signedIn(); allow create, update, delete: if canManage(); }
  }
}
